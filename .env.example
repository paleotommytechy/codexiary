# Cloud journal (use the URL shown under Convex Dashboard → Deployment settings)
NEXT_PUBLIC_CONVEX_URL=
# Existing Convex project: ifeoluwa-tomiwa / codexiary
# Selected deployment in dashboard: fantastic-panda-480
# Never guess the URL from the dashboard pathname; copy the backend URL.

# Clerk is ONLY the identity provider + OAuth server for ChatGPT.
# All journal, posts and voice-profile data live in Convex.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Same 32+ character random value must also be configured in Convex
# as CODEXIARY_MCP_BRIDGE_SECRET. Keep it secret. Never prefix NEXT_PUBLIC_.
CODEXIARY_MCP_BRIDGE_SECRET=

# Optional canonical Vercel origin
NEXT_PUBLIC_APP_URL=https://your-codexiary.vercel.app

# In-app generation only; NOT required for ChatGPT MCP connection
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
